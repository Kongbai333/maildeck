# 复制为 .env 后填入真实值再 `docker compose up -d`（.env 已被 .gitignore 忽略，切勿提交）

# 必填：32 字节 base64 主密钥，用于加密账号凭据 / 服务商 API Key。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILDECK_MASTER_KEY=

# 首次启动自动创建的管理员账号 / 密码（密码必填）
MAILDECK_ADMIN_USERNAME=admin
MAILDECK_ADMIN_PASSWORD=

# 可选：会话有效期（天）
MAILDECK_SESSION_TTL_DAYS=7

# 可选：允许的 CORS 源（网页同源部署通常留空即可）
# MAILDECK_CORS_ORIGINS=https://your-domain.example

# 可选：旧版单 Token 接口（等价管理员），一般不用
# MAILDECK_API_TOKEN=

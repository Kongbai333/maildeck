# 32 字节 base64 主密钥（加密 refresh token / 服务商 API Key）。生成方式：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILDECK_MASTER_KEY=

# 首次启动自动创建的管理员账号。密码留空则随机生成，并在启动日志里打印一次。
MAILDECK_ADMIN_USERNAME=admin
MAILDECK_ADMIN_PASSWORD=

# 登录会话有效期（天）。
MAILDECK_SESSION_TTL_DAYS=7

# 可选：设置后旧的单用户 Bearer Token 仍可访问遗留 /api 接口（等价管理员）。
# 新的网页端使用账号登录，不再需要它。
MAILDECK_API_TOKEN=

# 用户释放邮箱时是否顺手清空远端收件箱（默认 1；置 0 可关闭）。
MAILDECK_RELEASE_CLEAR_INBOX=1

# Optional HTTP(S) proxy used for Microsoft Graph / IMAP connections.
MAILDECK_PROXY_URL=

# Comma-separated browser origins allowed by CORS during local web development.
MAILDECK_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

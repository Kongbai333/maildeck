{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MailDeck",
  "version": "0.3.1",
  "identifier": "com.maildeck.desktop",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MailDeck",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "backgroundColor": "#FAFAFA",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; connect-src 'self' http: https: ipc: http://ipc.localhost; frame-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["../build/icon.ico", "../build/icon.png"],
    "resources": {
      "resources/node.exe": "node.exe",
      "resources/maildeck-server.mjs": "maildeck-server.mjs"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}

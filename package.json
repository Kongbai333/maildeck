{
  "name": "maildeck",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "description": "MailDeck — 多用户网页邮箱工作台：邮箱池管理、临时邮箱、邮件阅读与直播关注。",
  "scripts": {
    "dev": "npm run dev:cloud",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "npm run dev:webapp",
    "dev:webapp": "vite webapp",
    "dev:cloud": "concurrently -k \"npm:dev:server\" \"npm:dev:webapp\"",
    "start": "node dist-server/server/src/index.js",
    "start:server": "tsx server/src/index.ts",
    "start:server:prod": "npm start",
    "start:cloud": "npm run build && npm start",
    "build": "npm run build:cloud",
    "build:server": "node -e \"require('fs').rmSync('dist-server',{recursive:true,force:true})\" && tsc -p server/tsconfig.build.json",
    "build:webapp": "vite build webapp",
    "build:cloud": "npm run build:webapp && npm run build:server",
    "clean": "node -e \"const fs=require('fs'); for(const dir of ['webapp/dist','dist-server']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "preview": "npm start",
    "typecheck:webapp": "tsc -p webapp/tsconfig.json --noEmit --pretty false",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit --pretty false",
    "typecheck:shared": "tsc -p shared/tsconfig.json --noEmit --pretty false",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit --pretty false",
    "typecheck": "npm run typecheck:webapp && npm run typecheck:server && npm run typecheck:shared && npm run typecheck:tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm test",
    "audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org/"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^10.1.10",
    "@zone-eu/mailsplit": "5.4.30",
    "dompurify": "3.4.17",
    "fastify": "^5.12.8",
    "imapflow": "2.11.0",
    "lucide-react": "^0.511.0",
    "mailparser": "3.14.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.15.23",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.5.0",
    "jsdom": "29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "nanoid": "3.3.18",
    "ip-address": "10.7.5"
  }
}
